# Copy this file to .env and fill in your values. Never commit .env itself.

# Local MongoDB (matches a default local install):
MONGO_URI=mongodb://localhost:27017/interviewPortal

# OR MongoDB Atlas (cloud) — use this instead if you set up Atlas:
# MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/interviewPortal

# Any long random string — used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_string

PORT=5000
NODE_ENV=development

# ---- Password recovery email (optional in development) ----
# In development without SMTP, the reset page returns a local testing link.
# For real email delivery, configure all SMTP values below.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM=Smart Interview Portal <no-reply@example.com>
# Frontend origin used to build emailed password-reset links.
FRONTEND_URL=http://localhost:5500

# ---- Coding round: Judge0 code execution ----
# Create a key at https://rapidapi.com/judge0-official/api/judge0-ce
# In development, a blank key uses only an available local interpreter/compiler.
# If neither is available, code execution fails without awarding a score.
# Production requires this key. Add it as RAPIDAPI_KEY in the Render backend
# service's Environment settings; never commit or paste its value into source.
RAPIDAPI_KEY=
